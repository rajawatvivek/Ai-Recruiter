# Copy this file to .env.local and fill in your values
OPENAI_API_KEY=your-openai-api-key-here

# MySQL (the database and tables are created automatically on first request)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hireai

# Default admin account created on first run, plus a secret for signing session cookies
ADMIN_EMAIL=admin@hireai.com
ADMIN_PASSWORD=admin123
AUTH_SECRET=change-this-to-a-long-random-string

# Set to false to skip demo jobs, candidates and demo accounts
SEED_SAMPLE_DATA=true
